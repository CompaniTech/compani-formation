{
  "type": "module",
  "scripts": {
    "start": "chmod +x start.sh && ./start.sh",
    "build": "chmod +x build.sh && ./build.sh",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "eject": "expo eject",
    "test": "node_modules/jest/bin/jest.js",
    "ts-lint": "tsc --noEmit && eslint ./src --ext .js,.jsx,.ts,.tsx",
    "eas-build-pre-install": "echo $ANDROID_GOOGLE_SERVICES_BASE64 | base64 --decode > ./google-services.json"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "testPathIgnorePatterns": [
      "\\.snap$",
      "<rootDir>/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-clone-referenced-element|@react-native-community|@react-native-async-storage|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|native-base|@sentry/.*|react-redux|mime|immer|@formatjs)"
    ],
    "cacheDirectory": ".jest/cache",
    "setupFiles": [
      "./mock.js"
    ]
  },
  "dependencies": {
    "@eslint/js": "~10.0.1",
    "@expo/metro-runtime": "~57.0.14",
    "@formatjs/intl-datetimeformat": "~7.6.0",
    "@formatjs/intl-getcanonicallocales": "~3.2.11",
    "@formatjs/intl-locale": "~5.3.10",
    "@formatjs/intl-numberformat": "~9.4.0",
    "@formatjs/intl-pluralrules": "~6.3.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-masked-view/masked-view": "~0.3.2",
    "@react-native-vector-icons/ant-design": "^13.1.3",
    "@react-native-vector-icons/feather": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "@react-navigation/bottom-tabs": "~7.18.17",
    "@react-navigation/material-top-tabs": "~7.6.16",
    "@react-navigation/native": "~7.3.17",
    "@react-navigation/stack": "~7.10.23",
    "@reduxjs/toolkit": "~2.12.0",
    "@sentry/react-native": "~8.23.0",
    "array-flat-polyfill": "~1.0.1",
    "axios": "~1.19.0",
    "babel-jest": "~30.4.1",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jest": "~29.16.1",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-print": "~57.0.1",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.18",
    "expo-video": "~57.0.3",
    "globals": "~17.11.0",
    "luxon": "~3.7.2",
    "metro": "^0.84.2",
    "metro-config": "~0.84.2",
    "metro-resolver": "~0.84.2",
    "mime": "~4.1.0",
    "qs": "~6.15.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "~7.0.2",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-dnd": "~2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "~4.3.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "~9.3.0"
  },
  "devDependencies": {
    "@babel/core": "~7.29.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "~7.18.6",
    "@babel/plugin-proposal-optional-chaining": "~7.21.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "~14.0.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "~4.17.25",
    "@types/luxon": "~3.7.5",
    "@types/qs": "~6.15.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@typescript-eslint/eslint-plugin": "~8.67.0",
    "@typescript-eslint/parser": "~8.67.0",
    "axios-mock-adapter": "~2.1.0",
    "babel-preset-expo": "~57.0.0",
    "dotenv": "~17.4.2",
    "eslint": "~10.9.0",
    "eslint-plugin-react": "~7.37.4",
    "eslint-plugin-react-hooks": "~7.1.1",
    "expo-doctor": "~1.20.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "sinon": "~22.1.0",
    "test-renderer": "~1.2.0",
    "ts-jest": "~29.4.12",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "~22.20.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
